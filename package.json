{
  "name": "ui-vuivui",
  "version": "0.1.0",
  "description": "Thư viện Web Component vui vẻ cho các thao tác thường gặp: upload, in, đăng nhập, OTP, captcha…",
  "type": "module",
  "license": "MIT",
  "main": "./src/index.js",
  "module": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./basket-upload": "./src/basket-upload/basket-upload.js",
    "./core": "./src/core/index.js",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./src/index.js",
    "./src/basket-upload/basket-upload.js",
    "./dist/*.js"
  ],
  "scripts": {
    "dev": "vite --port 5180",
    "build": "vite build",
    "preview": "vite preview --port 5181",
    "test": "vitest run"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
